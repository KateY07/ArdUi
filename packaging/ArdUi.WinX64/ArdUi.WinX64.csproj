<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>KateY07.ArdUi.WinX64</PackageId>
    <PackageVersion>3.0.0-pre.8</PackageVersion>
    <Authors>KateY07</Authors>
    <Description>ArdUi Windows x64 application and installer.</Description>
    <PackageTags>ardui;remote-desktop;p2p;windows;win-x64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/KateY07/ArdUi</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="payload\ArdUi.exe" Pack="true" PackagePath="tools/" />
    <None Include="payload\ArdUi.exe.sha256" Pack="true" PackagePath="tools/" />
    <None Include="payload\config.json" Pack="true" PackagePath="tools/" />
    <None Include="payload\install.ps1" Pack="true" PackagePath="tools/" />
    <None Include="payload\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="tools/" />
    <PackageReference Include="KateY07.Ard.WinX64" Version="[3.0.0-pre.2]" />
    <PackageReference Include="KateY07.FRD.WinX64" Version="[1.0.0-pre.13]" />
  </ItemGroup>
</Project>
