<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>ArdUi.Performance</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems><ProductionSourceRoot Condition="'$(ProductionSourceRoot)' == ''">$(MSBuildProjectDirectory)/../..</ProductionSourceRoot></PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(ProductionSourceRoot)/Core/**/*.cs" LinkBase="Production/Core" />
    <Compile Include="$(ProductionSourceRoot)/Transport/**/*.cs" LinkBase="Production/Transport" />
    <Compile Include="$(ProductionSourceRoot)/Overlay/**/*.cs" LinkBase="Production/Overlay" />
    <Compile Include="$(ProductionSourceRoot)/TransitClient/**/*.cs" LinkBase="Production/TransitClient" />
    <Compile Include="$(ProductionSourceRoot)/Frd/**/*.cs" LinkBase="Production/Frd" />
    <Compile Include="../../Testing/TransitTest.cs" Link="Testing/TransitTest.cs" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
